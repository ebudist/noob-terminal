# Ghostty reads this file at ~/.config/ghostty/config.
# Run `ghostty +show-config --default` to list all 634 options and their
# defaults. Only put a line here when it differs from the default.

command = /opt/homebrew/bin/fish

font-family = "MesloLGS Nerd Font Mono Regular"
font-size = 15

# Send Option as Alt so Option+Delete deletes a word. The cost is macOS
# Option+key Unicode input, which stops working.
macos-option-as-alt = true

# Keep Cmd+C in Ghostty. Without a selection, the default binding sends
# the key on, and tmux turns it into Alt+C.
keybind = super+c=copy_to_clipboard

# Written by Claude Code `/terminal-setup`. Ghostty now handles Shift+Enter
# on its own, so test a multiline prompt before you remove this line.
keybind = shift+enter=text:\x1b\r
